# ═══════════════════════════════════════════════════════════════
# SAP Job Automator — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your API key.
# Only ONE AI provider is needed. Priority: Claude > Groq > Gemini
# ═══════════════════════════════════════════════════════════════

# OPTION 1: Claude API (BEST quality — requires API credits at console.anthropic.com)
# NOTE: Claude Pro subscription does NOT include API access.
# You need separate API credits (~$5 minimum). Cost: ~$0.01-0.03 per generation.
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxx
# CLAUDE_MODEL=claude-sonnet-4-20250514

# OPTION 2: Groq (FREE tier — good quality, fast)
# Sign up at console.groq.com for a free API key
# GROQ_API_KEY=gsk_xxxxxxxxxxxxx
# GROQ_MODEL=llama-3.3-70b-versatile

# OPTION 3: Google Gemini (FREE tier available)
# Get key at aistudio.google.com
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxx
# GEMINI_MODEL=gemini-2.0-flash

# ═══════════════════════════════════════════════════════════════
# Playwright settings (optional)
# ═══════════════════════════════════════════════════════════════
# Set to "false" to see the browser window during scraping (useful for debugging)
# PW_HEADLESS=true

# Server port (default: 3000)
# PORT=3000

